    "postinstall": "nuxt prepare",
    "sync:s3": "aws s3 sync .output/public/ s3://reka.app --delete --acl public-read",
    "test": "vitest run",
    "test:watch": "vitest watch --coverage",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:nuxt": "vitest run --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:playwright": "playwright test",
    "test:playwright:report": "playwright show-report",
    "test:playwright:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps",
    "lint": "oxlint lint .",
    "fix": "oxlint . --fix && eslint . --fix",
    "lint:eslint": "eslint --ext .ts,.vue .",
    "release:major": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --major",
    "release:minor": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --minor",
